# ==========================================================
# ORNEK ortam dosyasi. Kullanmak icin:
#   cp .env.example .env      (Windows: copy .env.example .env)
# ve degerleri kendi ortamina gore doldur. .env git'e gitmez.
# ==========================================================

# --- Sunucu ---
SERVER_PORT=8080

# --- PostgreSQL Baglantisi ---
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=servicedesk
DB_USERNAME=postgres
DB_PASSWORD=degistir-beni
DB_SCHEMA=servicedesk

# --- JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
SQL_INIT_MODE=always
